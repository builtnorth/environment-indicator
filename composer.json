{
	"name": "siratik/environment-indicator",
	"description": "Admin-bar indicator showing which environment a WordPress site is running in",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Built North",
			"email": "hello@builtnorth.co"
		}
	],
	"require": {
		"php": ">=8.1",
		"siratik/package-loader": "^0.1"
	},
	"require-dev": {
		"10up/wp_mock": "^1.0",
		"builtnorth/coding-standards": "^1.0",
		"mockery/mockery": "^1.5",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Siratik\\EnvironmentIndicator\\": "inc/classes/"
		},
		"files": [
			"register.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Siratik\\EnvironmentIndicator\\Tests\\": "tests/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:unit": "phpunit --testsuite Unit",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"phpcompat": "phpcs -p inc --standard=PHPCompatibility --runtime-set testVersion 8.1-"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"extra": {
		"branch-alias": {
			"dev-main": "0.1.x-dev",
			"dev-dev": "0.1.x-dev"
		}
	}
}
